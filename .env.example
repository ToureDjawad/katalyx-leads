# Copier ce fichier en .env puis remplir les valeurs.

# --- Obligatoire pour le scoring par Claude (sinon : mode dégradé heuristique) ---
ANTHROPIC_API_KEY=

# --- Offres d'emploi France Travail (gratuit) ---
# Créer une application sur https://francetravail.io (API « Offres d'emploi v2 »)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# --- Recherche du contact du décideur (optionnel, payant, conforme RGPD) ---
# Un seul suffit. Dropcontact est recommandé (société française, sans base de données stockée).
DROPCONTACT_API_KEY=
LUSHA_API_KEY=
